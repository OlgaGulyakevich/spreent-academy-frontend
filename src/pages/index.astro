---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout
  title="Spreent Academy — Online Education Courses"
  description="Find the best online courses for your career at Spreent Academy. Expert instructors, real projects, lifetime access."
>
  <Header />

  <main>
    <Hero />

    <!-- ============================================ -->
    <!-- ABOUT                                        -->
    <!-- ============================================ -->

    <section class="about" data-test="about">
      <div class="container about__container">
        <h2 class="about__title" data-reveal="true">
          Why Choose Spreent&nbsp;Academy
        </h2>

        <ul class="about__cards">
          <li class="about__card about__card--teachers">
            <div class="about__card-tag">Who will teach you?</div>
            <h3>Expert Instructors</h3>
            <p>
              Courses are taught by practicing experts currently working
              at&nbsp;industry-leading companies
            </p>
            <div class="about__card-media" aria-hidden="true">
              <picture>
                <source
                  type="image/webp"
                  width="441"
                  height="489"
                  srcset="img/about/teacher@1x.webp 1x, img/about/teacher@2x.webp 2x"
                />
                <img
                  src="img/about/teacher@1x.png"
                  srcset="img/about/teacher@2x.png 2x"
                  width="441"
                  height="489"
                  alt=""
                  loading="lazy"
                />
              </picture>
            </div>
          </li>

          <li class="about__card about__card--skills">
            <div class="about__card-tag">What will I gain?</div>
            <h3>Hands-On Skills</h3>
            <p>
              Hands-on, profession-specific knowledge. Train on&nbsp;real
              projects and build your own product
            </p>

            <div class="about__card-decor" aria-hidden="true">
              <div class="about__card-decor-rect"></div>
              <div class="about__card-decor-circle"></div>

              <div class="about__card-decor-label about__card-decor-label--you">
                <svg width="26" height="26" aria-hidden="true">
                  <use href="./__spritemap#sprite-cursor-arrow"></use>
                </svg>
                <span>You</span>
              </div>

              <div class="about__card-decor-label about__card-decor-label--ux">
                <svg width="26" height="26" aria-hidden="true">
                  <use href="./__spritemap#sprite-cursor-hand"></use>
                </svg>
                <span>UX Lead</span>
              </div>
            </div>
          </li>

          <li class="about__card about__card--knowledge">
            <div class="about__card-tag">What will I learn?</div>
            <h3>Modern Knowledge</h3>
            <p>
              We know what employers need and build curricula around current
              market trends
            </p>
            <div class="about__card-logo" aria-hidden="true">
              <img
                src="img/icons/spreent-circle.svg"
                width="562"
                height="552"
                alt=""
                loading="lazy"
              />
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- ============================================ -->
    <!-- COMMUNITY                                    -->
    <!-- ============================================ -->

    <section class="community" data-test="community">
      <div class="container community__container">
        <h2 class="visually-hidden">Our Graduates</h2>

        <ul class="community__avatar-list">
          <li class="community__avatar-item">
            <picture>
              <source
                type="image/webp"
                width="110"
                height="110"
                srcset="img/community/avatar-1@1x.webp 1x, img/community/avatar-1@2x.webp 2x"
              />
              <img
                src="img/community/avatar-1@1x.jpg"
                srcset="img/community/avatar-1@2x.jpg 2x"
                width="110"
                height="110"
                alt="Academy graduate"
                loading="lazy"
              />
            </picture>
          </li>
          <li class="community__avatar-item">
            <picture>
              <source
                type="image/webp"
                width="110"
                height="110"
                srcset="img/community/avatar-2@1x.webp 1x, img/community/avatar-2@2x.webp 2x"
              />
              <img
                src="img/community/avatar-2@1x.jpg"
                srcset="img/community/avatar-2@2x.jpg 2x"
                width="110"
                height="110"
                alt="Academy graduate"
                loading="lazy"
              />
            </picture>
          </li>
          <li class="community__avatar-item">
            <picture>
              <source
                type="image/webp"
                width="110"
                height="110"
                srcset="img/community/avatar-3@1x.webp 1x, img/community/avatar-3@2x.webp 2x"
              />
              <img
                src="img/community/avatar-3@1x.jpg"
                srcset="img/community/avatar-3@2x.jpg 2x"
                width="110"
                height="110"
                alt="Academy graduate"
                loading="lazy"
              />
            </picture>
          </li>
          <li class="community__avatar-item">
            <picture>
              <source
                type="image/webp"
                width="110"
                height="110"
                srcset="img/community/avatar-4@1x.webp 1x, img/community/avatar-4@2x.webp 2x"
              />
              <img
                src="img/community/avatar-4@1x.jpg"
                srcset="img/community/avatar-4@2x.jpg 2x"
                width="110"
                height="110"
                alt="Academy graduate"
                loading="lazy"
              />
            </picture>
          </li>
          <li class="community__avatar-item community__avatar-item--join">
            <a
              class="community__join"
              href="#footer-form"
              aria-label="Join the community"
            >
              <svg width="24" height="24" aria-hidden="true">
                <use href="./__spritemap#sprite-plus"></use>
              </svg>
            </a>
          </li>
        </ul>

        <div class="community__stats">
          <div class="community__count">
            <p class="community__count-number">Over&nbsp;100</p>
            <p class="community__count-label">
              graduates since the academy launched
            </p>
          </div>

          <ul class="community__factoids">
            <li class="community__factoid">
              <p class="community__factoid-number">78%</p>
              <p class="community__factoid-text">
                would recommend Spreent Academy to their friends
                and&nbsp;colleagues
              </p>
            </li>
            <li class="community__factoid">
              <p class="community__factoid-number">89%</p>
              <p class="community__factoid-text">
                rate the quality and value <br /> of knowledge gained at&nbsp;spreent
              </p>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ============================================ -->
    <!-- PRICE                                        -->
    <!-- ============================================ -->

    <section class="price" data-test="price">
      <div class="container price__container">
        <h2 class="price__title" data-reveal="true">Pricing</h2>

        <div class="price__card">
          <div class="price__card-inner">
            <div class="price__plan">
              <h3 class="price__plan-name">Basic Plan</h3>
              <ul class="price__features">
                <li>Lifetime access to&nbsp;materials</li>
                <li>With feedback and&nbsp;assignments</li>
                <li>Portfolio and resume review</li>
                <li>Start immediately or with a&nbsp;group</li>
                <li>24% discount when paying in&nbsp;full</li>
                <li>Certificate upon completion</li>
              </ul>
            </div>

            <div class="price__pricing">
              <p class="price__label">Price</p>
              <div class="price__amounts">
                <p class="price__amount">
                  <span class="price__current">83&nbsp;890&nbsp;₽</span>
                  <span class="price__old">110&nbsp;388&nbsp;₽</span>
                </p>
                <p class="price__or">or</p>
                <p class="price__amount">
                  <span class="price__current">419&nbsp;000&nbsp;₸</span>
                  <span class="price__old">552&nbsp;000&nbsp;₸</span>
                </p>
              </div>
              <a class="btn btn--primary price__btn" href="#footer-form"
                >Buy Now</a
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================ -->
    <!-- WORK                                         -->
    <!-- ============================================ -->

    <section class="work" data-test="work">
      <div class="container work__container">
        <div class="work__content">
          <h2 class="work__title" data-reveal="true">
            Where Our<br class="br-not-mobile" /> Graduates&nbsp;Work
          </h2>
          <p class="work__lead">
            Start your career at&nbsp;<span class="text-nowrap"
              >industry-leading</span
            > companies
          </p>
          <a class="btn btn--primary work__btn" href="#footer-form">Join Us</a>
        </div>

        <ul class="work__logos">
          <li class="work__logo-item work__logo-item--google">
            <svg width="95" height="32" aria-label="Google" role="img">
              <use href="./__spritemap#sprite-google"></use>
            </svg>
          </li>
          <li class="work__logo-item work__logo-item--epam">
            <svg width="94" height="30" aria-label="EPAM" role="img">
              <use href="./__spritemap#sprite-epam"></use>
            </svg>
          </li>
          <li class="work__logo-item work__logo-item--netflix">
            <svg width="122" height="33" aria-label="Netflix" role="img">
              <use href="./__spritemap#sprite-netflix"></use>
            </svg>
          </li>
          <li class="work__logo-item work__logo-item--empty" aria-hidden="true">
          </li>
          <li class="work__logo-item work__logo-item--booking">
            <svg width="165" height="28" aria-label="Booking.com" role="img">
              <use href="./__spritemap#sprite-booking"></use>
            </svg>
          </li>
          <li class="work__logo-item work__logo-item--rustore">
            <svg width="160" height="41" aria-label="RuStore" role="img">
              <use href="./__spritemap#sprite-rustore"></use>
            </svg>
          </li>
          <li class="work__logo-item work__logo-item--mish">
            <svg width="84" height="32" aria-label="mish" role="img">
              <use href="./__spritemap#sprite-mish"></use>
            </svg>
          </li>
          <li class="work__logo-item work__logo-item--chulakov">
            <svg width="140" height="16" aria-label="Chulakov" role="img">
              <use href="./__spritemap#sprite-chulakov"></use>
            </svg>
          </li>
          <li class="work__logo-item work__logo-item--vcru">
            <svg width="48" height="44" aria-label="vc.ru" role="img">
              <use href="./__spritemap#sprite-vc"></use>
            </svg>
          </li>
          <li class="work__logo-item work__logo-item--ibm">
            <svg width="91" height="34" aria-label="IBM" role="img">
              <use href="./__spritemap#sprite-ibm"></use>
            </svg>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <!-- ============================================ -->
  <!-- FOOTER                                       -->
  <!-- ============================================ -->

  <footer class="footer" data-test="footer">
    <section class="footer__certificate">
      <div class="container footer__certificate-container">
        <div
          class="footer__certificate-inner"
          data-reveal-stagger="120"
          data-reveal-threshold="0.8"
          data-reveal-threshold-mobile="0.6"
        >
          <div class="footer__certificate-info">
            <h2 data-reveal="true" data-reveal-type="clip">
              Get Your Course<br />
              <span class="nowrap-desktop">Completion Certificate</span>
            </h2>
            <p data-reveal="true" data-reveal-type="fade">
              Training is conducted under a&nbsp;state-issued educational
              license
            </p>
            <a
              class="btn btn--primary footer__certificate-btn"
              data-reveal="true"
              href="#footer-form">Start Learning</a
            >
          </div>

          <div
            class="footer__certificate-card certificate"
            data-reveal="true"
            data-reveal-type="scale"
            data-reveal-delay="0"
            aria-hidden="true"
          >
            <div class="certificate__header">
              <svg class="certificate__logo" width="106" height="23">
                <use href="./__spritemap#sprite-logo"></use>
              </svg>
              <span class="certificate__tag">Profession: Systems Analyst</span>
            </div>

            <p class="certificate__title">Certificate</p>
            <p class="certificate__note">Top performance on the course</p>

            <dl class="certificate__details">
              <div class="certificate__field certificate__field--name">
                <dt>Awarded to</dt>
                <dd>Ilya Petrov</dd>
              </div>
              <div class="certificate__field">
                <dt>Completion date</dt>
                <dd>July 15, 2024</dd>
              </div>
              <div class="certificate__field">
                <dt>Course author</dt>
                <dd>Innokentiy Bodrov</dd>
              </div>
            </dl>

            <svg
              class="certificate__stamp"
              width="200"
              height="200"
              viewBox="0 0 200 200"
            >
              <defs>
                <path
                  id="stamp-arc-top"
                  d="M 21,100 a 79,79 0 1 1 158,0 a 79,79 0 1 1 -158,0"></path>
                <path
                  id="stamp-arc-bottom"
                  d="M 11,100 a 89,89 0 1 0 178,0 a 89,89 0 1 0 -178,0"></path>
              </defs>
              <circle class="certificate__stamp-ring" cx="100" cy="100" r="97"
              ></circle>
              <circle class="certificate__stamp-core" cx="100" cy="100" r="70"
              ></circle>
              <text class="certificate__stamp-top">
                <textpath
                  href="#stamp-arc-top"
                  startoffset="25%"
                  text-anchor="middle">spreent academy</textpath
                >
              </text>
              <text class="certificate__stamp-bottom">
                <textpath
                  href="#stamp-arc-bottom"
                  startoffset="25%"
                  text-anchor="middle"
                  >upgrade your career through practice</textpath
                >
              </text>
              <text
                class="certificate__stamp-dot"
                x="14"
                y="100"
                text-anchor="middle"
                dominant-baseline="central">·</text
              >
              <text
                class="certificate__stamp-dot"
                x="186"
                y="100"
                text-anchor="middle"
                dominant-baseline="central">·</text
              >
              <text
                class="certificate__stamp-letter"
                x="100"
                y="100"
                text-anchor="middle"
                dominant-baseline="central">S</text
              >
            </svg>
          </div>
        </div>
      </div>
    </section>

    <section class="footer__form-section" id="footer-form">
      <div class="container footer__form-container">
        <h2 class="footer__form-title" data-reveal="true">
          Upgrade Your Career
        </h2>

        <form action="https://echo.htmlacademy.ru" method="POST">
          <fieldset class="footer__form-fields">
            <legend class="visually-hidden">Contact details</legend>

            <div class="footer__form-field">
              <label class="visually-hidden" for="form-name">Name</label>
              <input
                id="form-name"
                type="text"
                name="name"
                placeholder="Name"
                required
                minlength="2"
                autocomplete="name"
              />
              <span class="footer__form-error" aria-live="polite"></span>
            </div>

            <div class="footer__form-field">
              <label class="visually-hidden" for="form-phone">Phone</label>
              <input
                id="form-phone"
                type="tel"
                name="phone"
                placeholder="Phone"
                required
                autocomplete="tel"
              />
              <span class="footer__form-error" aria-live="polite"></span>
            </div>

            <div class="footer__form-field">
              <label class="visually-hidden" for="form-email">Email</label>
              <input
                id="form-email"
                type="email"
                name="email"
                placeholder="Email"
                required
                pattern="[^@\s]+@[^@\s]+\.[^@\s]+"
                autocomplete="email"
              />
              <span class="footer__form-error" aria-live="polite"></span>
            </div>
          </fieldset>

          <button class="btn btn--secondary footer__form-btn" type="submit">
            Send Request
          </button>
        </form>

        <p class="footer__form-disclaimer">
          By clicking Send Request, you&nbsp;agree to the
          <a class="footer__form-disclaimer-link" href="#"
            >processing of&nbsp;your personal data</a
          >
        </p>

        <div
          class="footer__notification footer__notification--success"
          role="alert"
          aria-hidden="true"
        >
          <span class="footer__notification-icon">
            <svg width="11" height="8" aria-hidden="true">
              <use href="./__spritemap#sprite-check-mark"></use>
            </svg>
          </span>
          <p>Thank you! We'll be in&nbsp;touch shortly.</p>
        </div>

        <div
          class="footer__notification footer__notification--error"
          role="alert"
          aria-hidden="true"
        >
          <span class="footer__notification-icon">
            <svg width="14" height="14" aria-hidden="true">
              <use href="./__spritemap#sprite-close"></use>
            </svg>
          </span>
          <p>Something went wrong. Please try&nbsp;again.</p>
        </div>
      </div>
    </section>

    <div class="footer__bottom">
      <div class="container footer__bottom-container">
        <a class="logo logo--light footer__logo" href="/">
          <svg width="267" height="59" aria-hidden="true">
            <use href="./__spritemap#sprite-logo"></use>
          </svg>
          <span class="visually-hidden">spreent</span>
        </a>

        <nav class="footer__nav" aria-label="Footer navigation">
          <ul class="footer__nav-list">
            <li><a class="footer__nav-link" href="#">About</a></li>
            <li><a class="footer__nav-link" href="#">Corporate Training</a></li>
            <li><a class="footer__nav-link" href="#">Payment</a></li>
            <li><a class="footer__nav-link" href="#">My Account</a></li>
            <li><a class="footer__nav-link" href="#">Contact&nbsp;Us</a></li>
            <li><a class="footer__nav-link" href="#">Privacy Policy</a></li>
          </ul>
        </nav>

        <div class="footer__meta">
          <p class="footer__copyright">
            Bohdan Honcharenko Academy&nbsp;&copy;&nbsp;2024
          </p>
          <a
            class="footer__agency"
            href="https://mish.design"
            target="_blank"
            rel="nofollow noopener noreferrer"
          >
            <span class="footer__agency-by">by</span>
            <svg width="85" height="30" aria-label="mish" role="img">
              <use href="./__spritemap#sprite-mish"></use>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </footer>
</BaseLayout>
