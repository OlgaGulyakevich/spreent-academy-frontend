---
import { Icon } from "astro-icon/components";
import AboutCard from "./AboutCard.astro";
---

<section class="about" data-test="about">
  <div class="container about__container">
    <h2 class="about__title" data-reveal="true">
      Why Choose Spreent&nbsp;Academy
    </h2>

    <ul class="about__cards">
      <AboutCard
        modifier="teachers"
        tag="Who will teach you?"
        title="Expert Instructors"
        text={"Courses are taught by practicing experts currently working at industry-leading companies"}
      >
        <div class="about__card-media" aria-hidden="true">
          <picture>
            <source
              type="image/webp"
              width="441"
              height="489"
              srcset="img/about/teacher@1x.webp 1x, img/about/teacher@2x.webp 2x"
            />
            <img
              src="img/about/teacher@1x.png"
              srcset="img/about/teacher@2x.png 2x"
              width="441"
              height="489"
              alt=""
              loading="lazy"
            />
          </picture>
        </div>
      </AboutCard>

      <AboutCard
        modifier="skills"
        tag="What will I gain?"
        title="Hands-On Skills"
        text={"Hands-on, profession-specific knowledge. Train on real projects and build your own product"}
      >
        <div class="about__card-decor" aria-hidden="true">
          <div class="about__card-decor-rect"></div>
          <div class="about__card-decor-circle"></div>

          <div class="about__card-decor-label about__card-decor-label--you">
            <Icon
              name="cursor-arrow"
              width="26"
              height="26"
              aria-hidden="true"
            />
            <span>You</span>
          </div>

          <div class="about__card-decor-label about__card-decor-label--ux">
            <Icon
              name="cursor-hand"
              width="26"
              height="26"
              aria-hidden="true"
            />
            <span>UX Lead</span>
          </div>
        </div>
      </AboutCard>

      <AboutCard
        modifier="knowledge"
        tag="What will I learn?"
        title="Modern Knowledge"
        text="We know what employers need and build curricula around current market trends"
      >
        <div class="about__card-logo" aria-hidden="true">
          <img
            src="img/icons/spreent-circle.svg"
            width="562"
            height="552"
            alt=""
            loading="lazy"
          />
        </div>
      </AboutCard>
    </ul>
  </div>
</section>
