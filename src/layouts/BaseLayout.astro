---
// Global styles: importing .scss in the frontmatter makes Astro bundle it as global CSS
import "../sass/style.scss";

// Props each page passes in (title / description, optional social preview image)
interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = "/og-image.jpg" } = Astro.props;

// Absolute URLs for this page: og:url / canonical must point to the page itself,
// otherwise LinkedIn and Google treat every page as a copy of the homepage.
const SITE = "https://spreent-academy-frontend.vercel.app";
// No trailing slash (except the root): /ui-kit is the address shared in the CV and LinkedIn,
// and Vercel serves both /ui-kit and /ui-kit/ — canonical picks the one we link to.
const path = Astro.url.pathname.replace(/(.)\/$/, "$1");
const pageUrl = new URL(path, SITE).href;
const imageUrl = new URL(ogImage, SITE).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="courses, online learning, education, design, IT, UX, UI, Spreent Academy"
    />
    <meta name="application-name" content="Spreent Academy" />
    <meta name="theme-color" content="#0d1627" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Spreent Academy" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="canonical" href={pageUrl} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicons/favicon.svg" type="image/svg+xml" />
    <link
      rel="icon"
      href="/favicons/favicon-96x96.png"
      sizes="96x96"
      type="image/png"
    />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
    <link
      rel="manifest"
      href="/site.webmanifest"
      crossorigin="use-credentials"
    />

    <!-- Font preload (critical weights only) -->
    <link
      rel="preload"
      href="/fonts/Manrope-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/LoosWide-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Hero image preload (LCP candidate) -->
    <link
      rel="preload"
      href="/img/hero/artur@1x.webp"
      as="image"
      type="image/webp"
    />
  </head>
  <body>
    <!-- Page content is injected here -->
    <slot />

    <!-- Astro bundles main.ts + 13 modules into one ES module; intl-tel-input is a lazy
         chunk, dynamically imported only when the footer form nears the viewport -->
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
