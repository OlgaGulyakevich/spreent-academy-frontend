root: true

parserOptions:
  ecmaVersion: 2023
  sourceType: 'module'

env:
  es6: true
  browser: true

extends:
  - "htmlacademy/vanilla"   # JS rules for vanilla modules
  - "prettier"              # turn off eslint formatting rules — Prettier owns formatting

# .astro files need the Astro parser; their frontmatter is TypeScript,
# so the inner parser is @typescript-eslint/parser
overrides:
  - files: ["*.astro"]
    parser: "astro-eslint-parser"
    parserOptions:
      parser: "@typescript-eslint/parser"
      extraFileExtensions: [".astro"]
    extends:
      - "plugin:astro/recommended"
      - "prettier"

  # Script-блоки внутри .astro — тоже TypeScript, но astro-eslint-parser выносит
  # их в отдельные виртуальные файлы с расширением .js, поэтому им нужен свой
  # TS-парсер. (Glob-паттерны в комментариях писать нельзя — ломают js-yaml.)
  - files: ["**/*.astro/*.js", "*.astro/*.js"]
    parser: "@typescript-eslint/parser"
    parserOptions:
      sourceType: "module"
    rules:
      # TS-типы no-undef принимает за необъявленные переменные; несуществующие
      # имена и так ловит компилятор, поэтому на TS-коде правило лишнее.
      no-undef: off
